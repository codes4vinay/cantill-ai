# ==========================================
# Cantill ProcureOS - Environment Variables
# ==========================================

# --- Backend (server/.env) ---
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.example.mongodb.net/corvo_procurement?retryWrites=true&w=majority
SELF_PING_URL=https://cantill-ai-pk3w.onrender.com

# --- Frontend (client/.env) ---
# For local dev: http://localhost:5000/api
# For production: https://cantill-ai-pk3w.onrender.com/api
VITE_API_URL=https://cantill-ai-pk3w.onrender.com/api
